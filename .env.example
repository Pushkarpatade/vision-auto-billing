# Server Configuration
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# AI Cashier & Concierge (Google Gemini / Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional hosted Roboflow exact-SKU workflow (set ROBOFLOW_ENABLED=true if using cloud workflow)
ROBOFLOW_ENABLED=false
ROBOFLOW_API_KEY=replace_with_your_roboflow_private_api_key
ROBOFLOW_WORKSPACE=pushkar-patade
ROBOFLOW_WORKFLOW_ID=grocery-auto-billing-demo-1795578899600
ROBOFLOW_CONFIDENCE_THRESHOLD=0.80
ROBOFLOW_LABEL_TO_SKU_JSON={"coke_500ml":"coke_bottle","sprite_250ml":"sprite_small","sprite_740ml":"sprite_large","water_500ml":"aqua_velly_small","water_1l":"aqua_velly_large","snack_pack":"snack_pack"}
